---
import { SITE, NAV, COMMUNES, telHref, mailHref } from '../config/site';
import { withBase } from '../utils/url';
import WhatsAppButton from './WhatsAppButton.astro';
---

<footer class="mt-16 bg-brand-900 text-brand-50">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-3">
    <section>
      <h2 class="!text-white text-lg">{SITE.nom}</h2>
      <p class="mt-2 text-sm">
        Conception de jardins, broyage et débroussaillage de la végétation à {SITE.ville} ({SITE.departement}) et dans toute la Camargue.
      </p>
      <p class="mt-3 text-sm">
        <span class="inline-flex flex-wrap items-center gap-2">
          <a class="underline" href={telHref}>{SITE.telephone}</a>
          <WhatsAppButton size="sm" />
        </span>
        <br />
        <a class="underline" href={mailHref}>{SITE.email}</a>
      </p>
      <p class="mt-3 text-sm">{SITE.adresseRue}, {SITE.codePostal} {SITE.ville}</p>
    </section>

    <nav aria-label="Pied de page">
      <h2 class="!text-white text-lg">Le site</h2>
      <ul class="mt-2 space-y-1 text-sm">
        {NAV.map((item) => <li><a class="underline" href={withBase(item.path)}>{item.label}</a></li>)}
        <li><a class="underline" href={withBase('/mentions-legales/')}>Mentions légales</a></li>
      </ul>
    </nav>

    <section>
      <h2 class="!text-white text-lg">Zone d’intervention</h2>
      <p class="mt-2 text-sm">{COMMUNES.join(', ')} et communes alentour.</p>
    </section>
  </div>
  <p class="border-t border-brand-700 px-4 py-4 text-center text-xs">
    © {new Date().getFullYear()} {SITE.nom} — SIRET {SITE.siret}
  </p>
</footer>
