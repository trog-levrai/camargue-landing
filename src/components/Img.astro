---
// Image responsive : WebP + srcset, lazy par défaut. `alt` obligatoire (en français).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  src,
  alt,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [480, 800, 1200],
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['webp']}
  widths={widths}
  sizes={sizes}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
/>
