---
import { SITE, NAV } from '../config/site';
import { withBase } from '../utils/url';

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-earth-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={withBase('/')} class="font-display text-lg font-bold text-brand-700 sm:text-xl">
      {SITE.nom}
    </a>

    {/* Menu hamburger sans JavaScript : case à cocher + label (le <nav> reste dans le DOM). */}
    <input id="menu-toggle" type="checkbox" class="peer sr-only" aria-label="Ouvrir le menu" />
    <label
      for="menu-toggle"
      class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border border-earth-300 text-brand-900 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-600 md:hidden"
    >
      <span class="sr-only">Menu</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </label>

    <nav
      aria-label="Navigation principale"
      class="absolute inset-x-0 top-full hidden border-b border-earth-100 bg-white shadow-md peer-checked:block md:static md:block md:border-0 md:bg-transparent md:shadow-none"
    >
      <ul class="flex flex-col px-4 py-2 md:flex-row md:items-center md:gap-1 md:p-0">
        {
          NAV.map((item) => {
            const href = withBase(item.path);
            const active = current === href;
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-3 py-3 text-base font-medium hover:bg-brand-50 md:py-2 md:text-sm lg:text-base',
                    active ? 'text-brand-700 underline decoration-2 underline-offset-8' : 'text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
