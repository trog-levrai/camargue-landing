---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import { SITE } from '../config/site';
import JsonLd from '../components/JsonLd.astro';
import { FAQ } from '../data/faq';
import { faqPage } from '../utils/jsonld';
---

<BaseLayout
  title={`FAQ débroussaillement et jardins en Camargue | ${SITE.nom}`}
  description="Le débroussaillement est-il obligatoire ? Quelles communes couvertes ? Réponses aux questions fréquentes sur le broyage, le débroussaillage et la création de jardins en Camargue."
  breadcrumb="FAQ"
>
  <JsonLd slot="head" data={faqPage(FAQ)} />
  <h1 class="text-3xl sm:text-4xl">Questions fréquentes sur le débroussaillement et les jardins</h1>
  <p class="mt-4 max-w-3xl text-lg">
    Le débroussaillement est obligatoire dans de nombreux cas dans le Gard : retrouvez ici les réponses aux
    questions les plus posées sur nos prestations de broyage, de débroussaillage et de création de jardins en
    Camargue.
  </p>

  <div class="mt-8 max-w-3xl space-y-3">
    {
      FAQ.map((item) => (
        <details class="group rounded-xl border border-earth-100 bg-white p-4 open:shadow-sm">
          <summary class="cursor-pointer list-none font-display text-lg font-semibold text-brand-900 marker:hidden">
            <h2 class="inline text-lg">{item.question}</h2>
          </summary>
          <p class="mt-3">{item.answer}</p>
        </details>
      ))
    }
  </div>

  <div class="mt-16"><CallToAction titre="Une autre question ?" texte="Appelez-nous ou écrivez-nous, nous vous répondons avec plaisir." /></div>
</BaseLayout>
